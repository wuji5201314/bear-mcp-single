# Runtime
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m

# MySQL
BEAR_MYSQL_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/bear_mcp_single?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
BEAR_MYSQL_USERNAME=YOUR_MYSQL_USERNAME
BEAR_MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
BEAR_DB_MIN_IDLE=5
BEAR_DB_MAX_POOL_SIZE=20

# Admin security: replace with a long random value before deployment
BEAR_ADMIN_JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
BEAR_ADMIN_JWT_EXPIRE_SECONDS=7200
BEAR_MCP_DEMO_TOKEN=CHANGE_ME

# Xxx Admin service-to-service authentication (must match Xxx Admin)
XXX_ADMIN_BASE_URL=http://xxx-admin:8080
XXX_BEAR_MCP_SHARED_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# TOS
# 服务端读写使用内网 Endpoint，返回给浏览器的预签名 URL 使用公网 Endpoint
BEAR_TOS_ENDPOINT=tos-cn-shanghai.ivolces.com
BEAR_TOS_PUBLIC_ENDPOINT=tos-cn-shanghai.volces.com
BEAR_TOS_REGION=cn-shanghai
BEAR_TOS_BUCKET=YOUR_TOS_BUCKET
BEAR_TOS_ACCESS_KEY=YOUR_TOS_ACCESS_KEY
BEAR_TOS_SECRET_KEY=YOUR_TOS_SECRET_KEY
BEAR_TOS_UPLOAD_EXPIRE_SECONDS=600

# Feishu
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_TENANT_TOKEN_URL=https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal
FEISHU_MCP_URL=https://mcp.feishu.cn/mcp
FEISHU_MCP_CREDENTIAL_TYPE=TAT
