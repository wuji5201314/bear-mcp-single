# Runtime
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m

# MySQL
MCPFORGE_MYSQL_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/mcpforge?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
MCPFORGE_MYSQL_USERNAME=YOUR_MYSQL_USERNAME
MCPFORGE_MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MCPFORGE_DB_MIN_IDLE=5
MCPFORGE_DB_MAX_POOL_SIZE=20

# Admin security: replace with a long random value before deployment
MCPFORGE_ADMIN_JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
MCPFORGE_ADMIN_JWT_EXPIRE_SECONDS=7200
MCPFORGE_MCP_DEMO_TOKEN=CHANGE_ME

# Xxx Admin service-to-service authentication (must match Xxx Admin)
XXX_ADMIN_BASE_URL=http://xxx-admin:8080
MCPFORGE_XXX_SHARED_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# TOS
# 服务端读写使用内网 Endpoint，返回给浏览器的预签名 URL 使用公网 Endpoint
MCPFORGE_TOS_ENDPOINT=tos-cn-shanghai.ivolces.com
MCPFORGE_TOS_PUBLIC_ENDPOINT=tos-cn-shanghai.volces.com
MCPFORGE_TOS_REGION=cn-shanghai
MCPFORGE_TOS_BUCKET=YOUR_TOS_BUCKET
MCPFORGE_TOS_ACCESS_KEY=YOUR_TOS_ACCESS_KEY
MCPFORGE_TOS_SECRET_KEY=YOUR_TOS_SECRET_KEY
MCPFORGE_TOS_UPLOAD_EXPIRE_SECONDS=600

# Feishu
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_TENANT_TOKEN_URL=https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal
FEISHU_MCP_URL=https://mcp.feishu.cn/mcp
FEISHU_MCP_CREDENTIAL_TYPE=TAT

# Images (optional overrides for docker-compose)
MCPFORGE_IMAGE=mcpforge:latest
